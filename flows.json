        "info": "<style>\r\n    .nrdb-ui-group.acad .v-card {\r\n        background-color: #e88113db !important;\r\n        /* Azul escuro USCS /\r\n        border-radius: 16px !important;\r\n        border: 2px solid #00509E;\r\n        / Borda azul intermediária /\r\n        color: #ffffff;\r\n        / Texto branco para contraste /\r\n        margin: 45px;\r\n        / Espaço ao redor do card /\r\n        padding: 15px;\r\n        / Mais espaço interno /\r\n        width: 300px;\r\n        / Mantém a largura /\r\n        height: 275px;\r\n        / Mantém a altura /\r\n        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);\r\n        / Sombra suave /\r\n        display: flex;\r\n        flex-direction: column;\r\n        align-items: center;\r\n        justify-content: center;\r\n    }\r\n\r\n    .nrdb-ui-group.acad .v-card-title {\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n        color: #FFD700;\r\n        / Amarelo dourado para destaque /\r\n        text-transform: uppercase;\r\n        / Texto em caixa alta /\r\n        text-align: center;\r\n        margin-bottom: 5px;\r\n        / Espaço entre o título e os botões /\r\n        font-family: \"Arial\", sans-serif;\r\n    }\r\n\r\n\r\n    .nrdb-ui-group.acad .v-btn:hover {\r\n        background-color: #FFD700;\r\n        / Amarelo dourado ao passar o mouse /\r\n        color: #003366;\r\n        / Azul escuro no texto */\r\n    }\r\n</style>"
    },
