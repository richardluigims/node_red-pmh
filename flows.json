    {
        "id": "8ce8a3f1d24b87b0",
        "type": "function",
        "z": "a7769f71b1a40557",
        "name": "Startup",
        "func": "//If there is not token return session undefined\nif(msg.token == undefined)\n{\n    msg.session = undefined;\n    return msg;\n}\n\n//If there is token check if server side has details\nvar details = flow.get(msg.token);\n//If none, then return session undefined\nif(details == undefined)\n{\n    msg.session = undefined;\n}\n//If there is return to front end that session details\nelse\n{\n    //Session details\n    msg.session = \n    {\n        'uniqueid': details.session.uniqueid,\n        'user_id': details.session.user_id,\n        'user_code': details.session.user_code,\n        'user_name': details.session.user_name,\n        'start_Time': undefined\n    };\n    \n    //User Details\n    msg.payload = \n    {\n        'user_id': details.user.user_id,\n        'isActive': details.user.isActive,\n        'user_code': details.user.user_code,\n        'user_name': details.user.user_name,\n        'avatar': details.user.avatar\n    }\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
