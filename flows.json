        "z": "a7769f71b1a40557",
        "name": "function 5",
        "func": "let doc = msg.payload;  // O nó do Firestore retorna um único documento diretamente\n\nmsg.toNumber = doc.numCliente;\n\nif (doc.codTipoRecurso === 0) {\n    msg.payload = \"A caixa d'água em \" + doc.nomeAmbiente + \" está abaixo do nível, favor verificar.\";\n} else if (doc.codTipoRecurso === 1) {\n    msg.payload = \"O sensor de gás detectou um vazamento de gás em \" + doc.nomeAmbiente + \".\";\n} else {\n    msg.payload = \"Alerta no recurso localizado em \" + doc.nomeAmbiente + \".\";\n}\n\nreturn msg;\n",
