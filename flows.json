    {
        "id": "2c8a383e63a2b2b5",
        "type": "function",
        "z": "a7769f71b1a40557",
        "name": "function 1",
        "func": "// Extrair variáveis do payload recebido pelo ESP32\nlet idEmpresa = msg.payload.idEmpresa;\nlet idRecurso = msg.payload.idRecurso;\nlet idAmbiente = msg.payload.idAmbiente;\nlet valor = msg.payload.valor;\nlet timestamp = msg.payload.timestamp;  // Já vem do ESP32\n\n// Criar novo payload com os dados esperados\nmsg.payload = {\n    idEmpresa: idEmpresa,\n    idRecurso: idRecurso,\n    idAmbiente: idAmbiente,\n    valor: valor,\n    timestamp: timestamp\n};\n\n// Retornar a mensagem com novo formato\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1120,
        "y": 340,
        "wires": [
